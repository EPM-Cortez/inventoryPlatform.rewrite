# Origin of the Inventory API that the Vite dev server proxies to.
# The API must be reachable and its dev certificate trusted (or `secure: false`,
# which vite.config.ts already sets).
#
# `dotnet run --project src/Inventory.Api` in ../backend listens on
# https://localhost:7270 and http://localhost:5292.
VITE_API_PROXY_TARGET=https://localhost:7270

# Displayed in the sidebar. Purely cosmetic; the API is single-school and does not
# expose a school profile endpoint yet.
VITE_SCHOOL_NAME=Example School
