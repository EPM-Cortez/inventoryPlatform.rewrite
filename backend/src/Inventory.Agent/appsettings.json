{
  "Agent": {
    "ServerBaseUrl": "",
    "EnrollmentTokenFilePath": "",
    "DeviceKeyName": "InventoryAgentSigningKeyV1",
    "AllowSoftwareKey": false,
    "CollectInstalledSoftware": true,
    "CheckInIntervalSeconds": 21600,
    "EnrollmentRetrySeconds": 60,
    "HttpTimeoutSeconds": 60,
    "QueueMaximumItems": 64,
    "QueueFlushBatchSize": 8,
    "DeleteEnrollmentTokenFileAfterEnrollment": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EventLog": {
      "SourceName": "Inventory Endpoint Agent",
      "LogName": "Application",
      "LogLevel": {
        "Default": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  }
}
